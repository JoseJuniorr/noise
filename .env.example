# --- Desenvolvimento local do site (copie para .env.local) -------------------
# markdown (padrão) lê content/posts; strapi lê a API do CMS.
CONTENT_SOURCE=markdown
# STRAPI_URL=http://localhost:1337
# STRAPI_API_TOKEN=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Droplet (copie para .env, ao lado do docker-compose.yml) ----------------
# Gere cada segredo com: openssl rand -base64 32
SITE_DOMAIN=noise.exemplo.com
CMS_DOMAIN=cms.noise.exemplo.com

POSTGRES_PASSWORD=

# Strapi — APP_KEYS são quatro segredos separados por vírgula.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Cloudinary (Dashboard → API Keys). O mesmo nome serve ao Strapi e ao site.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Criado no painel do Strapi depois da primeira subida (Settings → API Tokens → Read-only).
STRAPI_API_TOKEN=
# Mesmo valor no cabeçalho x-revalidate-secret do webhook no Strapi.
REVALIDATE_SECRET=

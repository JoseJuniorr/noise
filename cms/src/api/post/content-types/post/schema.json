{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Registro",
    "description": "Um registro do fluxo: texto, código, acorde ou foto. Sem categorias — a forma muda só a apresentação."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "writtenAt": {
      "type": "datetime",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "text",
        "code",
        "chord",
        "photo"
      ],
      "default": "text",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "chordName": {
      "type": "string"
    },
    "chordShape": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageFilter": {
      "type": "enumeration",
      "enum": [
        "submersa",
        "natural",
        "preto_e_branco",
        "sepia",
        "alto_contraste",
        "vinheta"
      ],
      "default": "submersa"
    },
    "imageRatio": {
      "type": "enumeration",
      "enum": [
        "original",
        "quadrado",
        "retrato",
        "paisagem",
        "panoramico"
      ],
      "default": "original"
    },
    "imageFocus": {
      "type": "enumeration",
      "enum": [
        "automatico",
        "rosto",
        "centro",
        "topo",
        "base"
      ],
      "default": "automatico"
    }
  }
}
